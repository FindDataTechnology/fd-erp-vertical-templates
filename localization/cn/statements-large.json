        "6711"
      ]
    },
    {
      "key": "total_profit",
      "label": "三、利润总额",
      "formula": [
        "operating_profit",
        "+nonoperating_income",
        "-nonoperating_expense"
      ]
    },
    {
      "key": "income_tax",
      "label": "减：所得税费用",
