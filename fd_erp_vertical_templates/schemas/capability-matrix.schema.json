{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finddata/erp/capability-matrix.schema.json",
  "title": "电商能力矩阵（ecommerce-capability-matrix/v1）",
  "description": "平台 × 流的能力状态。代码侧校验在 fd_erp_vertical_templates/capability.py（零新依赖），本文件是互操作与文档口径，两者必须一致：改这里必须同步改校验器与测试。",
  "type": "object",
  "required": ["schema", "vertical", "platforms"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "ecommerce-capability-matrix/v1"},
    "vertical": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "review_window_days": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "flows"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "display_zh": {"type": "string"},
          "display_en": {"type": "string"},
          "channel_kind": {
            "type": "string",
            "enum": ["platform_api", "catalog_snapshot", "static_schema_missing", "merchant_erp"]
          },
          "connector": {"type": ["string", "null"]},
          "flows": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"enum": ["orders", "settlements", "inventory", "refunds"]},
            "additionalProperties": {"$ref": "#/$defs/cell"}
          }
        }
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "required": ["status", "channel", "evidence", "reason"],
      "properties": {
        "status": {"enum": ["available", "unavailable", "unmapped"]},
        "channel": {"type": "string", "minLength": 1},
        "reason": {
          "type": "string",
          "description": "非 available 必填：对外要能解释为什么拿不到。"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "ref"],
            "properties": {
              "kind": {
                "enum": ["provider_action", "runtime_read", "catalog_entry", "deployment"]
              },
              "ref": {"type": "string", "minLength": 1},
              "note": {"type": "string"}
            }
          }
        },
        "measured_at": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "review_window_days": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "available"}}},
          "then": {
            "properties": {
              "reason": {"type": "string"},
              "measured_at": {"type": "string"}
            }
          }
        }
      ],
      "description": "available 需同时具备 provider_action 与 runtime_read 证据且在复核窗内；否则加载期降级为 unmapped（见 capability._apply_downgrade）。"
    }
  }
}
