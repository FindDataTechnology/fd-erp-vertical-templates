{
 "schema": "erp-capability-claims/v1",
 "note": "对外能力声明 → 证据引用（optimize-erp-solution task 4.1）。这是「我们能说什么」的唯一出处：官网文案、方案文档与市场描述里的每条能力主张都必须能回指到这里的一条 claim，claim 的每条证据都必须能在仓内解析到。status=not_claimable 的条目可以出现在「不可宣称」清单里，但不得以肯定句式出现在对外材料中。",
 "updated_at": "2026-11-10",
 "surfaces": {
  "board-doc": "docs/erp/README.md",
  "official-web": "fd-official-web/src/components/ErpLanding.astro",
  "official-web-products": "fd-official-web/src/pages/products.astro",
  "official-web-products-zh": "fd-official-web/src/pages/zh/products.astro"
 },
 "scan": {
  "note": "对外材料的声明扫描：命中 assertion 句式且未被任何 claim 的 patterns 覆盖即判红。negative_markers 用于识别否定语境（「不自研」「不宣称」「挂账」），限定在同句或紧邻前缀内——否定列表不是声明。",
  "assertions": [
   {
    "id": "invoice",
    "pattern": "(?:支持|提供|可|已|能)(?:开票|发票|代开)"
   },
   {
    "id": "fund-execution",
    "pattern": "(?:支持|提供|已)(?:资金池|代收代付|分账执行|资金执行|资金归集)"
   },
   {
    "id": "monolith",
    "pattern": "(?:支持|提供|可|已)(?:单体\\s*ERP|表单式\\s*ERP)"
   },
   {
    "id": "live",
    "pattern": "已上线|已上架|已发布|已\\s*deploy|已写入\\s*(?:市场|registry)"
   }
  ],
  "negative_markers": [
   "不",
   "未",
   "无",
   "非",
   "禁止",
   "不得",
   "挂账",
   "不可",
   "DO NOT",
   "免"
  ],
  "generated_block_markers": {
   "not-claimable": [
    "<!-- claim-gate:begin:not-claimable -->",
    "<!-- claim-gate:end:not-claimable -->"
   ],
   "release-status": [
    "<!-- claim-gate:begin:release-status -->",
    "<!-- claim-gate:end:release-status -->"
   ]
  }
 },
